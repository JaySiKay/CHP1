import type { Routes } from '@angular/router';

export const AUTH_ROUTES: Routes = [
  {
    path: 'login',
    loadComponent: () => import('./pages/login/login').then((m) => m.Login),
  },
  {
    path: 'register',
    loadComponent: () => import('./pages/registr/register').then((m) => m.Register),
  },
  {
    path: '',
    redirectTo: 'login',
    pathMatch: 'full',
  },
];